<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="true">

    <display-name>OPENSCIENCE-API-PROXY</display-name>

    <servlet>
        <servlet-name>apiProxy</servlet-name>
        <servlet-class>cl.uss.ca.proxy.ApiProxyServlet</servlet-class>
        <init-param>
            <param-name>targetBase</param-name>
            <param-value>http://127.0.0.1:9080/api</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>apiProxy</servlet-name>
        <url-pattern>/*</url-pattern>
    </servlet-mapping>
</web-app>
