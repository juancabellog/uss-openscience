# Opcional: bin/server. El JAR de producción usa bootstrap.properties
# al empaquetar (./package-prod.sh), no este archivo.
# Nombres en MAYÚSCULAS: server.env no admite puntos.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uss-ca
DB_USER=root
DB_PASSWORD=

